<Window
    x:Class="LageFreeze.Views.MonitorSelectionWindow"
    x:Name="RootWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Monitor auswählen – LageFreeze"
    Width="680"
    Height="600"
    MinWidth="620"
    MinHeight="520"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="#FF0A1019">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource AppWindowStyle}" />
    </Window.Style>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="52"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Background="{StaticResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="18,0,4,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Monitor auswählen" />
                    <Button
                        x:Name="CloseButton"
                        Width="44"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Monitorauswahl schließen"
                        Click="CloseButtonClick"
                        Content="×"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource CloseTitleBarButtonStyle}"
                        ToolTip="Schließen" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,18,22,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="Ausgabemonitor festlegen" />
                    <TextBlock
                        MaxWidth="440"
                        Margin="0,4,0,0"
                        Foreground="{StaticResource MutedForegroundBrush}"
                        FontSize="13"
                        Text="Wähle den Monitor vor der Plexiglasscheibe." />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    MinWidth="158"
                    Margin="18,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Alle Monitore identifizieren"
                    Command="{Binding IdentifyMonitorsCommand}"
                    Content="IDENTIFIZIEREN"
                    FontSize="13"
                    Style="{StaticResource OutlineButtonStyle}" />
            </Grid>

            <Grid Grid.Row="2" Margin="22,0">
                <ListBox
                    x:Name="MonitorList"
                    AutomationProperties.Name="Verfügbare Monitore"
                    ItemsSource="{Binding Monitors}"
                    ItemContainerStyle="{StaticResource MonitorListItemStyle}"
                    SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="44"
                                    Height="44"
                                    VerticalAlignment="Center"
                                    Background="#FF173B50"
                                    CornerRadius="6">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Text="{Binding DisplayNumber}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}" />
                                        <Border
                                            Margin="9,0,0,0"
                                            Padding="7,2"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource SurfaceRaisedBrush}"
                                            CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                Foreground="{StaticResource MutedForegroundBrush}"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Text="HAUPTMONITOR" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Foreground="{StaticResource MutedForegroundBrush}"
                                        FontSize="13"
                                        Text="{Binding ResolutionText}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Margin="14,0,2,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    FontSize="22"
                                    Text="›" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border
                    Padding="20"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=MonitorList, Path=HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Text="Kein Monitor erkannt" />
                        <TextBlock
                            MaxWidth="420"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource MutedForegroundBrush}"
                            FontSize="13"
                            Text="Prüfe die Verbindung und die Windows-Anzeigeeinstellungen."
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Grid.Row="3"
                Margin="0,14,0,0"
                Padding="22,14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        MaxWidth="270"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource MutedForegroundBrush}"
                        FontSize="12"
                        Text="„Identifizieren“ zeigt die Nummer auf jedem Bildschirm." />
                    <Button
                        Grid.Column="1"
                        MinWidth="112"
                        AutomationProperties.Name="Monitorauswahl abbrechen"
                        Command="{Binding CancelCommand}"
                        Content="ABBRECHEN"
                        IsCancel="True"
                        Style="{StaticResource OutlineButtonStyle}" />
                    <Button
                        Grid.Column="3"
                        MinWidth="174"
                        AutomationProperties.Name="Ausgewählten Monitor übernehmen"
                        Command="{Binding ConfirmCommand}"
                        Content="ÜBERNEHMEN"
                        IsDefault="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMonitor}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
