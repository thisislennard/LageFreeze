<Window
    x:Class="LageFreeze.Views.MonitorSelectionWindow"
    x:Name="RootWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
    Title="Monitor auswählen – LageFreeze"
    Width="760"
    Height="700"
    MinWidth="660"
    MinHeight="560"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="#FF0A1019">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource AppWindowStyle}" />
    </Window.Style>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="60"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Background="{StaticResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="22,0,6,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Text="Monitor auswählen" />
                    <Button
                        Width="48"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Monitorauswahl schließen"
                        Command="{x:Static system:SystemCommands.CloseWindowCommand}"
                        CommandParameter="{Binding ElementName=RootWindow}"
                        Content="×"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource CloseTitleBarButtonStyle}"
                        ToolTip="Schließen" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="30,27,30,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="27"
                        FontWeight="SemiBold"
                        Text="Welcher Monitor soll einfrieren?" />
                    <TextBlock
                        MaxWidth="520"
                        Margin="0,7,0,0"
                        Style="{StaticResource MutedTextStyle}"
                        Text="Wähle den Monitor vor der Plexiglasscheibe. Die Auswahl wird für den nächsten Start gespeichert." />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    MinWidth="176"
                    Margin="24,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Alle Monitore identifizieren"
                    Command="{Binding IdentifyMonitorsCommand}"
                    Content="IDENTIFIZIEREN"
                    Style="{StaticResource OutlineButtonStyle}" />
            </Grid>

            <Grid Grid.Row="2" Margin="30,0">
                <ListBox
                    x:Name="MonitorList"
                    AutomationProperties.Name="Verfügbare Monitore"
                    ItemsSource="{Binding Monitors}"
                    ItemContainerStyle="{StaticResource MonitorListItemStyle}"
                    SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="52"
                                    Height="52"
                                    VerticalAlignment="Center"
                                    Background="#FF173B50"
                                    CornerRadius="12">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Text="{Binding DisplayNumber}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="19"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}" />
                                        <Border
                                            Margin="11,0,0,0"
                                            Padding="8,3"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource SurfaceRaisedBrush}"
                                            CornerRadius="6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                Foreground="{StaticResource MutedForegroundBrush}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="HAUPTMONITOR" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        Foreground="{StaticResource MutedForegroundBrush}"
                                        FontSize="15"
                                        Text="{Binding ResolutionText}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Margin="18,0,4,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    FontSize="25"
                                    FontWeight="SemiBold"
                                    Text="›" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border
                    Padding="24"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=MonitorList, Path=HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="21"
                            FontWeight="SemiBold"
                            Text="Kein Monitor erkannt" />
                        <TextBlock
                            MaxWidth="460"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Style="{StaticResource MutedTextStyle}"
                            Text="Prüfe die Verbindung und die Windows-Anzeigeeinstellungen. Die Liste wird bei Anzeigeänderungen aktualisiert." />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Grid.Row="3"
                Margin="0,22,0,0"
                Padding="30,18"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        MaxWidth="330"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource MutedForegroundBrush}"
                        FontSize="13"
                        Text="Tipp: „Identifizieren“ zeigt die Nummer direkt auf jedem Bildschirm." />
                    <Button
                        Grid.Column="1"
                        MinWidth="130"
                        AutomationProperties.Name="Monitorauswahl abbrechen"
                        Command="{Binding CancelCommand}"
                        Content="ABBRECHEN"
                        IsCancel="True"
                        Style="{StaticResource OutlineButtonStyle}" />
                    <Button
                        Grid.Column="3"
                        MinWidth="190"
                        AutomationProperties.Name="Ausgewählten Monitor übernehmen"
                        Command="{Binding ConfirmCommand}"
                        Content="MONITOR ÜBERNEHMEN"
                        IsDefault="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMonitor}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
