<views:PhysicalPixelWindow
    x:Class="LageFreeze.Views.FreezeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:LageFreeze.Views"
    Title="LageFreeze Standbild"
    WindowStyle="None"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True"
    Focusable="False"
    Cursor="None"
    Background="Black"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <Grid>
        <Image
            x:Name="FrozenImage"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            RenderOptions.EdgeMode="Aliased"
            SnapsToDevicePixels="True"
            Stretch="Fill" />
        <Border
            x:Name="DimmingOverlay"
            Background="Black"
            IsHitTestVisible="False"
            Opacity="0" />
    </Grid>
</views:PhysicalPixelWindow>
