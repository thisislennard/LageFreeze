<Window
    x:Class="LageFreeze.Views.SettingsWindow"
    x:Name="RootWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:LageFreeze.Models"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
    Title="Einstellungen – LageFreeze"
    Width="680"
    Height="700"
    MinWidth="620"
    MinHeight="560"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="#FF0A1019">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource AppWindowStyle}" />
    </Window.Style>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="52"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Background="{StaticResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="18,0,4,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Einstellungen" />
                    <Button
                        Width="44"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Einstellungen schließen"
                        Command="{x:Static system:SystemCommands.CloseWindowCommand}"
                        CommandParameter="{Binding ElementName=RootWindow}"
                        Content="×"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource CloseTitleBarButtonStyle}"
                        ToolTip="Schließen" />
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18,22,18">
                    <StackPanel Margin="2,0,2,16">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="LageFreeze anpassen" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{StaticResource MutedForegroundBrush}"
                            FontSize="13"
                            Text="Einstellungen bleiben ausschließlich auf diesem Computer." />
                    </StackPanel>

                    <Border Margin="0,0,0,12" Padding="18" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="ALLGEMEIN" />
                            <Grid Margin="0,12,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Standardmonitor" />
                                <ComboBox
                                    Grid.Column="1"
                                    AutomationProperties.Name="Standardmonitor"
                                    DisplayMemberPath="DisplayText"
                                    ItemsSource="{Binding Monitors}"
                                    SelectedItem="{Binding SelectedDefaultMonitor, Mode=TwoWay}" />
                            </Grid>
                            <WrapPanel>
                                <CheckBox
                                    Width="285"
                                    Margin="0,2,0,0"
                                    AutomationProperties.Name="LageFreeze mit Windows starten"
                                    Content="Mit Windows starten"
                                    IsChecked="{Binding IsAutostartEnabled, Mode=TwoWay}" />
                                <CheckBox
                                    Width="285"
                                    Margin="0,2,0,0"
                                    AutomationProperties.Name="Beim Windows-Start minimiert starten"
                                    Content="Beim Start minimieren"
                                    IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                    IsEnabled="{Binding IsAutostartEnabled}" />
                                <CheckBox
                                    Width="285"
                                    Margin="0,2,0,0"
                                    AutomationProperties.Name="System-Tray verwenden"
                                    Content="System-Tray verwenden"
                                    IsChecked="{Binding UseSystemTray, Mode=TwoWay}" />
                                <CheckBox
                                    Width="285"
                                    Margin="0,2,0,0"
                                    AutomationProperties.Name="Beim Schließen in den System-Tray minimieren"
                                    Content="Schließen minimiert in Tray"
                                    IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                    IsEnabled="{Binding UseSystemTray}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,12" Padding="18" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="TASTENKÜRZEL" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Foreground="{StaticResource MutedForegroundBrush}"
                                        FontSize="12"
                                        Text="Funktionieren systemweit." />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    MinHeight="38"
                                    Padding="13,6"
                                    AutomationProperties.Name="Tastenkürzel zurücksetzen"
                                    Command="{Binding ResetHotkeysCommand}"
                                    Content="STANDARD"
                                    FontSize="12"
                                    Style="{StaticResource OutlineButtonStyle}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Freeze- und Live-Tastenkürzel aktivieren"
                                    Content="Freeze / Live aktiv"
                                    IsChecked="{Binding EnableToggleHotkey, Mode=TwoWay}" />
                                <TextBox
                                    Grid.Column="1"
                                    AutomationProperties.Name="Tastenkürzel für Freeze und Live"
                                    IsEnabled="{Binding EnableToggleHotkey}"
                                    MaxLength="32"
                                    Text="{Binding ToggleHotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Aktualisieren-Tastenkürzel aktivieren"
                                    Content="Aktualisieren aktiv"
                                    IsChecked="{Binding EnableRefreshHotkey, Mode=TwoWay}" />
                                <TextBox
                                    Grid.Column="1"
                                    AutomationProperties.Name="Tastenkürzel zum Aktualisieren"
                                    IsEnabled="{Binding EnableRefreshHotkey}"
                                    MaxLength="32"
                                    Text="{Binding RefreshHotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <TextBlock
                                Margin="0,8,0,0"
                                Foreground="{StaticResource FrozenBrush}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{Binding ValidationMessage}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,12" Padding="18" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="ANZEIGE" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Standard-Zeichenmodus" />
                                <ComboBox
                                    Grid.Column="1"
                                    AutomationProperties.Name="Standard-Zeichenmodus"
                                    SelectedValue="{Binding DefaultDrawingMode, Mode=TwoWay}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="{x:Static models:DrawingMode.Original}" Content="Original" />
                                    <ComboBoxItem Tag="{x:Static models:DrawingMode.Dimmed}" Content="Leicht abgedunkelt" />
                                    <ComboBoxItem Tag="{x:Static models:DrawingMode.StronglyDimmed}" Content="Stark abgedunkelt" />
                                </ComboBox>
                            </Grid>

                            <Separator Margin="0,12" />

                            <CheckBox
                                AutomationProperties.Name="Eingefroren-Hinweis im Standbild anzeigen"
                                Content="„EINGEFROREN“-Hinweis im Standbild anzeigen"
                                IsChecked="{Binding ShowFrozenIndicator, Mode=TwoWay}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="28,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource MutedForegroundBrush}"
                                    FontSize="14"
                                    Text="Position des Hinweises" />
                                <ComboBox
                                    Grid.Column="1"
                                    AutomationProperties.Name="Position des Eingefroren-Hinweises"
                                    DisplayMemberPath="DisplayName"
                                    IsEnabled="{Binding ShowFrozenIndicator}"
                                    ItemsSource="{Binding FrozenIndicatorPositions}"
                                    SelectedValue="{Binding FrozenIndicatorPosition, Mode=TwoWay}"
                                    SelectedValuePath="Value" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="18" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="SCREENSHOTS" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    AutomationProperties.Name="Speicherordner für Standbilder"
                                    Text="{Binding ScreenshotFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="2"
                                    MinWidth="112"
                                    AutomationProperties.Name="Screenshot-Ordner auswählen"
                                    Command="{Binding BrowseScreenshotFolderCommand}"
                                    Content="DURCHSUCHEN"
                                    FontSize="12"
                                    Style="{StaticResource OutlineButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border
                Grid.Row="2"
                Padding="22,14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{StaticResource MutedForegroundBrush}"
                        FontSize="12"
                        Text="Änderungen gelten nach dem Speichern." />
                    <Button
                        Grid.Column="1"
                        MinWidth="112"
                        AutomationProperties.Name="Änderungen verwerfen"
                        Command="{Binding CancelCommand}"
                        Content="ABBRECHEN"
                        IsCancel="True"
                        Style="{StaticResource OutlineButtonStyle}" />
                    <Button
                        Grid.Column="3"
                        MinWidth="138"
                        AutomationProperties.Name="Einstellungen speichern"
                        Command="{Binding SaveCommand}"
                        Content="SPEICHERN"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
