<Window
    x:Class="LageFreeze.Views.SettingsWindow"
    x:Name="RootWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:LageFreeze.Models"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
    Title="Einstellungen – LageFreeze"
    Width="760"
    Height="820"
    MinWidth="680"
    MinHeight="620"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="#FF0A1019">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource AppWindowStyle}" />
    </Window.Style>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="60"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Background="{StaticResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="22,0,6,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Text="Einstellungen" />
                    <Button
                        Width="48"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Einstellungen schließen"
                        Command="{x:Static system:SystemCommands.CloseWindowCommand}"
                        CommandParameter="{Binding ElementName=RootWindow}"
                        Content="×"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource CloseTitleBarButtonStyle}"
                        ToolTip="Schließen" />
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,28,30,26">
                    <StackPanel Margin="2,0,2,22">
                        <TextBlock
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="LageFreeze anpassen" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource MutedTextStyle}"
                            Text="Alle Einstellungen werden ausschließlich lokal auf diesem Computer gespeichert." />
                    </StackPanel>

                    <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="ALLGEMEIN" />
                            <TextBlock Margin="0,18,0,7" FontSize="15" FontWeight="SemiBold" Text="Standardmonitor" />
                            <ComboBox
                                AutomationProperties.Name="Standardmonitor"
                                DisplayMemberPath="DisplayText"
                                ItemsSource="{Binding Monitors}"
                                SelectedItem="{Binding SelectedDefaultMonitor, Mode=TwoWay}" />

                            <CheckBox
                                Margin="0,18,0,0"
                                AutomationProperties.Name="LageFreeze mit Windows starten"
                                Content="LageFreeze mit Windows starten"
                                IsChecked="{Binding IsAutostartEnabled, Mode=TwoWay}" />
                            <CheckBox
                                Margin="0,7,0,0"
                                AutomationProperties.Name="Beim Windows-Start minimiert starten"
                                Content="Beim Windows-Start minimiert starten"
                                IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                IsEnabled="{Binding IsAutostartEnabled}" />
                            <CheckBox
                                Margin="0,7,0,0"
                                AutomationProperties.Name="System-Tray verwenden"
                                Content="System-Tray verwenden"
                                IsChecked="{Binding UseSystemTray, Mode=TwoWay}" />
                            <CheckBox
                                Margin="0,7,0,0"
                                AutomationProperties.Name="Beim Schließen in den System-Tray minimieren"
                                Content="Beim Schließen in den System-Tray minimieren"
                                IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                IsEnabled="{Binding UseSystemTray}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="TASTENKÜRZEL" />
                                    <TextBlock
                                        Margin="0,7,0,0"
                                        Style="{StaticResource MutedTextStyle}"
                                        Text="Die Kürzel funktionieren systemweit, auch wenn LageFreeze nicht aktiv ist." />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    MinHeight="44"
                                    Margin="18,0,0,0"
                                    Padding="16,8"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="Tastenkürzel zurücksetzen"
                                    Command="{Binding ResetHotkeysCommand}"
                                    Content="STANDARD"
                                    FontSize="13"
                                    Style="{StaticResource OutlineButtonStyle}" />
                            </Grid>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Width="260"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Freeze- und Live-Tastenkürzel aktivieren"
                                    Content="Freeze / Live aktiv"
                                    IsChecked="{Binding EnableToggleHotkey, Mode=TwoWay}" />
                                <TextBox
                                    Grid.Column="1"
                                    AutomationProperties.Name="Tastenkürzel für Freeze und Live"
                                    IsEnabled="{Binding EnableToggleHotkey}"
                                    MaxLength="32"
                                    Text="{Binding ToggleHotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Width="260"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Aktualisieren-Tastenkürzel aktivieren"
                                    Content="Aktualisieren aktiv"
                                    IsChecked="{Binding EnableRefreshHotkey, Mode=TwoWay}" />
                                <TextBox
                                    Grid.Column="1"
                                    AutomationProperties.Name="Tastenkürzel zum Aktualisieren"
                                    IsEnabled="{Binding EnableRefreshHotkey}"
                                    MaxLength="32"
                                    Text="{Binding RefreshHotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <TextBlock
                                Margin="0,12,0,0"
                                Foreground="{StaticResource FrozenBrush}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{Binding ValidationMessage}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="ANZEIGE" />
                            <TextBlock Margin="0,18,0,7" FontSize="15" FontWeight="SemiBold" Text="Standard-Zeichenmodus" />
                            <ComboBox
                                AutomationProperties.Name="Standard-Zeichenmodus"
                                SelectedValue="{Binding DefaultDrawingMode, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Tag="{x:Static models:DrawingMode.Original}" Content="Original" />
                                <ComboBoxItem Tag="{x:Static models:DrawingMode.Dimmed}" Content="Leicht abgedunkelt" />
                                <ComboBoxItem Tag="{x:Static models:DrawingMode.StronglyDimmed}" Content="Stark abgedunkelt" />
                            </ComboBox>
                            <TextBlock
                                Margin="0,9,0,0"
                                Style="{StaticResource MutedTextStyle}"
                                Text="Abdunkeln kann Markierungen auf einer Plexiglasscheibe besser sichtbar machen." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="SCREENSHOTS" />
                            <TextBlock Margin="0,18,0,7" FontSize="15" FontWeight="SemiBold" Text="Speicherordner" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    AutomationProperties.Name="Speicherordner für Standbilder"
                                    Text="{Binding ScreenshotFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="2"
                                    MinWidth="120"
                                    AutomationProperties.Name="Screenshot-Ordner auswählen"
                                    Command="{Binding BrowseScreenshotFolderCommand}"
                                    Content="DURCHSUCHEN"
                                    Style="{StaticResource OutlineButtonStyle}" />
                            </Grid>
                            <TextBlock
                                Margin="0,9,0,0"
                                Style="{StaticResource MutedTextStyle}"
                                Text="Standbilder bleiben lokal und werden niemals automatisch übertragen." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border
                Grid.Row="2"
                Padding="30,18"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{StaticResource MutedForegroundBrush}"
                        FontSize="13"
                        Text="Änderungen gelten nach dem Speichern." />
                    <Button
                        Grid.Column="1"
                        MinWidth="130"
                        AutomationProperties.Name="Änderungen verwerfen"
                        Command="{Binding CancelCommand}"
                        Content="ABBRECHEN"
                        IsCancel="True"
                        Style="{StaticResource OutlineButtonStyle}" />
                    <Button
                        Grid.Column="3"
                        MinWidth="160"
                        AutomationProperties.Name="Einstellungen speichern"
                        Command="{Binding SaveCommand}"
                        Content="SPEICHERN"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
