<views:PhysicalPixelWindow
    x:Class="LageFreeze.Views.IdentificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:LageFreeze.Views"
    Title="Monitor identifizieren"
    WindowStyle="None"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True"
    Focusable="False"
    Cursor="None"
    Background="#FF0A1019"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <Border
        Margin="24"
        Background="#FF121B29"
        BorderBrush="#FF36A9E8"
        BorderThickness="4"
        CornerRadius="24">
        <Grid IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="#FFA9B6C8"
                    FontFamily="Segoe UI Variable Text, Segoe UI"
                    FontSize="32"
                    FontWeight="SemiBold"
                    Text="MONITOR" />
                <TextBlock
                    x:Name="MonitorNumberText"
                    Margin="0,-14,0,-8"
                    HorizontalAlignment="Center"
                    Foreground="#FFF5F8FC"
                    FontFamily="Segoe UI Variable Display, Segoe UI"
                    FontSize="260"
                    FontWeight="Bold"
                    LineHeight="280"
                    Text="1" />
                <TextBlock
                    x:Name="MonitorNameText"
                    MaxWidth="900"
                    HorizontalAlignment="Center"
                    Foreground="#FF36A9E8"
                    FontFamily="Segoe UI Variable Text, Segoe UI"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Text="Anzeigegerät"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</views:PhysicalPixelWindow>
