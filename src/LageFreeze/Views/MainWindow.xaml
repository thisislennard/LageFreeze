<Window
    x:Class="LageFreeze.Views.MainWindow"
    x:Name="RootWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
    Title="LageFreeze"
    Width="820"
    Height="620"
    MinWidth="740"
    MinHeight="560"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResize"
    Background="#FF0A1019">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource AppWindowStyle}" />
    </Window.Style>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="52"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Background="{StaticResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="16,0,4,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border
                            Width="30"
                            Height="30"
                            Margin="0,0,10,0"
                            Background="#FF173B50"
                            CornerRadius="6">
                            <Image
                                Width="26"
                                Height="26"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="/LageFreeze;component/Assets/LageFreeze.png"
                                Stretch="Uniform" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="LageFreeze" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            Width="44"
                            Margin="0,0,2,0"
                            AutomationProperties.Name="Einstellungen öffnen"
                            Command="{Binding OpenSettingsCommand}"
                            Content="⚙"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Einstellungen" />
                        <Button
                            Width="44"
                            Margin="0,0,2,0"
                            AutomationProperties.Name="Fenster minimieren"
                            Command="{x:Static system:SystemCommands.MinimizeWindowCommand}"
                            CommandParameter="{Binding ElementName=RootWindow}"
                            Content="—"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Minimieren" />
                        <Button
                            Width="44"
                            AutomationProperties.Name="LageFreeze schließen"
                            Command="{x:Static system:SystemCommands.CloseWindowCommand}"
                            CommandParameter="{Binding ElementName=RootWindow}"
                            Content="×"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource CloseTitleBarButtonStyle}"
                            ToolTip="Schließen" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid Margin="24,20,24,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="18" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="AUSGABEMONITOR" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Text="{Binding SelectedMonitor.DisplayName, TargetNullValue=Kein Monitor ausgewählt, FallbackValue=Kein Monitor ausgewählt}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="{Binding SelectedMonitor.ResolutionText, TargetNullValue=Bitte Monitor auswählen}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button
                                    MinWidth="142"
                                    AutomationProperties.Name="Ausgabemonitor ändern"
                                    Command="{Binding ChangeMonitorCommand}"
                                    Content="MONITOR ÄNDERN"
                                    FontSize="13"
                                    Style="{StaticResource OutlineButtonStyle}" />
                                <Button
                                    MinWidth="142"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="Alle Monitore identifizieren"
                                    Command="{Binding IdentifyMonitorsCommand}"
                                    Content="IDENTIFIZIEREN"
                                    FontSize="13"
                                    Style="{StaticResource OutlineButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Padding="18" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="STATUS" />
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <Ellipse
                                            Width="12"
                                            Height="12"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource LiveBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource FrozenBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="25"
                                            FontWeight="Bold"
                                            Text="{Binding StatusText, TargetNullValue=LIVE, FallbackValue=LIVE}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource LiveBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource FrozenBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock
                                        MaxWidth="520"
                                        Margin="22,3,0,0"
                                        Foreground="{StaticResource MutedForegroundBrush}"
                                        FontSize="13"
                                        Text="{Binding StatusDescription, TargetNullValue=Der ausgewählte Monitor zeigt den aktuellen Windows-Inhalt.}" />
                                </StackPanel>

                                <Border
                                    Grid.Column="1"
                                    Padding="11,7"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    CornerRadius="5">
                                    <TextBlock
                                        Foreground="{StaticResource MutedForegroundBrush}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="F9  UMSCHALTEN" />
                                </Border>
                            </Grid>

                            <Button
                                Grid.Row="2"
                                MinHeight="62"
                                AutomationProperties.Name="Bild auf dem ausgewählten Monitor einfrieren"
                                Command="{Binding FreezeCommand}"
                                Content="BILD EINFRIEREN"
                                FontSize="18">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Grid Grid.Row="2">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    MinHeight="62"
                                    AutomationProperties.Name="Standbild mit dem aktuellen Monitorinhalt aktualisieren"
                                    Command="{Binding RefreshCommand}"
                                    Content="STANDBILD AKTUALISIEREN"
                                    FontSize="15"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                                <Button
                                    Grid.Column="2"
                                    MinHeight="62"
                                    AutomationProperties.Name="Live-Bild wiederherstellen"
                                    Command="{Binding RestoreLiveCommand}"
                                    Content="LIVE-BILD WIEDERHERSTELLEN"
                                    FontSize="15"
                                    Style="{StaticResource SuccessButtonStyle}" />
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource MutedForegroundBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="ZEICHENMODUS" />
                                <ComboBox
                                    Grid.Column="1"
                                    AutomationProperties.Name="Zeichenmodus für das Standbild"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding DrawingModes}"
                                    SelectedValue="{Binding DrawingMode, Mode=TwoWay}"
                                    SelectedValuePath="Value" />
                                <Button
                                    Grid.Column="3"
                                    MinWidth="188"
                                    MinHeight="44"
                                    AutomationProperties.Name="Aktuelles Standbild als PNG speichern"
                                    Command="{Binding SaveScreenshotCommand}"
                                    Content="STANDBILD SPEICHERN"
                                    FontSize="13"
                                    Style="{StaticResource OutlineButtonStyle}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Foreground="{StaticResource MutedForegroundBrush}"
                            FontSize="12"
                            Text="F9  Freeze / Live" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource MutedForegroundBrush}"
                            FontSize="12"
                            Text="Offline · keine Telemetrie" />
                        <TextBlock
                            Grid.Column="2"
                            Foreground="{StaticResource MutedForegroundBrush}"
                            FontSize="12"
                            Text="F10  Aktualisieren" />
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
