<Window
    x:Class="LageFreeze.Views.MainWindow"
    x:Name="RootWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
    Title="LageFreeze"
    Width="960"
    Height="760"
    MinWidth="820"
    MinHeight="680"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResize"
    Background="#FF0A1019">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource AppWindowStyle}" />
    </Window.Style>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="60"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Background="{StaticResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="18,0,6,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border
                            Width="38"
                            Height="38"
                            Margin="0,0,12,0"
                            Background="#FF173B50"
                            CornerRadius="10">
                            <Image
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="/LageFreeze;component/Assets/LageFreeze.png"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="LageFreeze" />
                            <TextBlock
                                Foreground="{StaticResource MutedForegroundBrush}"
                                FontSize="11"
                                Text="MONITOR-STANDBILD" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            Width="48"
                            Margin="0,0,2,0"
                            AutomationProperties.Name="Einstellungen öffnen"
                            Command="{Binding OpenSettingsCommand}"
                            Content="⚙"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Einstellungen" />
                        <Button
                            Width="48"
                            Margin="0,0,2,0"
                            AutomationProperties.Name="Fenster minimieren"
                            Command="{x:Static system:SystemCommands.MinimizeWindowCommand}"
                            CommandParameter="{Binding ElementName=RootWindow}"
                            Content="—"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Minimieren" />
                        <Button
                            Width="48"
                            AutomationProperties.Name="LageFreeze schließen"
                            Command="{x:Static system:SystemCommands.CloseWindowCommand}"
                            CommandParameter="{Binding ElementName=RootWindow}"
                            Content="×"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource CloseTitleBarButtonStyle}"
                            ToolTip="Schließen" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid Margin="34,30,34,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="Außenmonitor steuern" />
                        <TextBlock
                            Margin="0,7,0,0"
                            Style="{StaticResource MutedTextStyle}"
                            Text="Monitor auswählen, Lagebild einfrieren und jederzeit sicher zum Live-Bild zurückkehren." />
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="AUSGABEMONITOR" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="26"
                                    FontWeight="SemiBold"
                                    Text="{Binding SelectedMonitor.DisplayName, TargetNullValue=Kein Monitor ausgewählt, FallbackValue=Kein Monitor ausgewählt}" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding SelectedMonitor.ResolutionText, TargetNullValue=Bitte Monitor auswählen}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Center">
                                <Button
                                    MinWidth="210"
                                    AutomationProperties.Name="Ausgabemonitor ändern"
                                    Command="{Binding ChangeMonitorCommand}"
                                    Content="MONITOR ÄNDERN"
                                    Style="{StaticResource OutlineButtonStyle}" />
                                <Button
                                    MinWidth="210"
                                    Margin="0,10,0,0"
                                    AutomationProperties.Name="Alle Monitore identifizieren"
                                    Command="{Binding IdentifyMonitorsCommand}"
                                    Content="IDENTIFIZIEREN"
                                    Style="{StaticResource OutlineButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="STATUS" />

                                    <StackPanel Margin="0,11,0,0" Orientation="Horizontal">
                                        <Ellipse
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource LiveBrush}" />
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect
                                                                BlurRadius="12"
                                                                Opacity="0.45"
                                                                ShadowDepth="0"
                                                                Color="{StaticResource LiveColor}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource FrozenBrush}" />
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect
                                                                        BlurRadius="12"
                                                                        Opacity="0.5"
                                                                        ShadowDepth="0"
                                                                        Color="{StaticResource FrozenColor}" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="30"
                                            FontWeight="Bold"
                                            Text="{Binding StatusText, TargetNullValue=LIVE, FallbackValue=LIVE}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource LiveBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource FrozenBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock
                                        MaxWidth="560"
                                        Margin="27,8,0,0"
                                        Style="{StaticResource MutedTextStyle}"
                                        Text="{Binding StatusDescription, TargetNullValue=Der ausgewählte Monitor zeigt den aktuellen Windows-Inhalt.}" />
                                </StackPanel>

                                <Border
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    Padding="14,9"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    CornerRadius="9">
                                    <TextBlock
                                        Foreground="{StaticResource MutedForegroundBrush}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="F9  UMSCHALTEN" />
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Button
                                    MinHeight="76"
                                    AutomationProperties.Name="Bild auf dem ausgewählten Monitor einfrieren"
                                    Command="{Binding FreezeCommand}"
                                    Content="BILD EINFRIEREN"
                                    FontSize="20">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Column="0"
                                        MinHeight="76"
                                        AutomationProperties.Name="Standbild mit dem aktuellen Monitorinhalt aktualisieren"
                                        Command="{Binding RefreshCommand}"
                                        Content="STANDBILD AKTUALISIEREN"
                                        FontSize="17"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button
                                        Grid.Column="2"
                                        MinHeight="76"
                                        AutomationProperties.Name="Live-Bild wiederherstellen"
                                        Command="{Binding RestoreLiveCommand}"
                                        Content="LIVE-BILD WIEDERHERSTELLEN"
                                        FontSize="17"
                                        Style="{StaticResource SuccessButtonStyle}" />

                                    <Grid Grid.Row="2" Grid.ColumnSpan="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource MutedForegroundBrush}"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="ZEICHENMODUS" />
                                        <ComboBox
                                            Grid.Column="1"
                                            AutomationProperties.Name="Zeichenmodus für das Standbild"
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding DrawingModes}"
                                            SelectedValue="{Binding DrawingMode, Mode=TwoWay}"
                                            SelectedValuePath="Value" />
                                        <Button
                                            Grid.Column="3"
                                            MinHeight="50"
                                            MinWidth="210"
                                            Margin="18,0,0,0"
                                            AutomationProperties.Name="Aktuelles Standbild als PNG speichern"
                                            Command="{Binding SaveScreenshotCommand}"
                                            Content="STANDBILD SPEICHERN"
                                            FontSize="14"
                                            Style="{StaticResource OutlineButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Foreground="{StaticResource MutedForegroundBrush}"
                            FontSize="13"
                            Text="F9  Freeze / Live" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="18,0"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource MutedForegroundBrush}"
                            FontSize="13"
                            Text="Offline · keine Telemetrie" />
                        <TextBlock
                            Grid.Column="2"
                            Foreground="{StaticResource MutedForegroundBrush}"
                            FontSize="13"
                            Text="F10  Standbild aktualisieren" />
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
